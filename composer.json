{
    "name": "wit3/filament-relation-navigator",
    "description": "Give every Filament relation manager its own page (/{record}/{relation}) and switch between them from the breadcrumb, reusing the relation managers you already have.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filamentphp",
        "relation-manager",
        "relation-pages",
        "breadcrumbs",
        "navigation",
        "livewire"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Salvatore Scalzi",
            "homepage": "https://github.com/wit3",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.13|^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Wit3\\FilamentRelationNavigator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wit3\\FilamentRelationNavigator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --testsuite=Feature",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "test:browser": "vendor/bin/pest --testsuite=Browser"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wit3\\FilamentRelationNavigator\\FilamentRelationNavigatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://wit3.github.io/filament-relation-navigator/",
    "support": {
        "docs": "https://wit3.github.io/filament-relation-navigator/",
        "issues": "https://github.com/wit3/filament-relation-navigator/issues",
        "source": "https://github.com/wit3/filament-relation-navigator"
    }
}
